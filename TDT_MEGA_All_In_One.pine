//@version=5
indicator("TDT MEGA - Complete Trading System", shorttitle="TDT MEGA", overlay=true, max_labels_count=500, max_lines_count=500, max_boxes_count=100)

// ================================================
// 1. CORE SEQUENCE SETTINGS
// ================================================
grp_core = "1. Core Sequence"
i_main_sequence = input.string("1,3,7,13,21,31,43", "Main Sequence", group=grp_core)
i_counting_direction = input.string("Neutral", "Direction", options=["Neutral", "Bullish", "Bearish"], group=grp_core)

// ================================================
// 2. ANCHOR SETTINGS - LTF
// ================================================
grp_ltf = "2. LTF Anchor"
i_ltf_anchor_mode = input.string("Manual", "Anchor Mode", options=["Manual", "Auto Pivot"], group=grp_ltf)
i_ltf_anchor_time = input.time(timestamp("2025-01-15 09:30"), "LTF Manual Anchor", group=grp_ltf, confirm=true)
i_ltf_auto_pivot_left = input.int(5, "Auto Pivot Left", minval=2, group=grp_ltf)
i_ltf_auto_pivot_right = input.int(5, "Auto Pivot Right", minval=2, group=grp_ltf)
i_show_ltf_lines = input.bool(true, "Connect LTF Lines", group=grp_ltf)

// ================================================
// 3. HTF 1 ANCHOR (1H, 15M, etc)
// ================================================
grp_htf1 = "3. HTF 1 Settings"
i_enable_htf1 = input.bool(true, "Enable HTF 1", group=grp_htf1)
i_htf1 = input.timeframe("60", "HTF 1 Timeframe", group=grp_htf1)
i_htf1_sequence = input.string("1,7,13,21,31", "HTF 1 Sequence", group=grp_htf1)
i_htf1_anchor_mode = input.string("Manual", "HTF 1 Anchor Mode", options=["Manual", "Auto Pivot"], group=grp_htf1)
i_htf1_anchor_time = input.time(timestamp("2025-01-15 09:30"), "HTF 1 Manual Anchor", group=grp_htf1, confirm=true)
i_show_htf1_lines = input.bool(true, "Connect HTF 1 Lines", group=grp_htf1)

// ================================================
// 4. HTF 2 ANCHOR (4H, 1H, etc)
// ================================================
grp_htf2 = "4. HTF 2 Settings"
i_enable_htf2 = input.bool(true, "Enable HTF 2", group=grp_htf2)
i_htf2 = input.timeframe("240", "HTF 2 Timeframe", group=grp_htf2)
i_htf2_sequence = input.string("1,7,13,21,31", "HTF 2 Sequence", group=grp_htf2)
i_htf2_anchor_mode = input.string("Manual", "HTF 2 Anchor Mode", options=["Manual", "Auto Pivot"], group=grp_htf2)
i_htf2_anchor_time = input.time(timestamp("2025-01-15 09:30"), "HTF 2 Manual Anchor", group=grp_htf2, confirm=true)
i_show_htf2_lines = input.bool(true, "Connect HTF 2 Lines", group=grp_htf2)

// ================================================
// 5. HTF 3 ANCHOR (Daily, etc)
// ================================================
grp_htf3 = "5. HTF 3 Settings"
i_enable_htf3 = input.bool(false, "Enable HTF 3", group=grp_htf3)
i_htf3 = input.timeframe("D", "HTF 3 Timeframe", group=grp_htf3)
i_htf3_sequence = input.string("1,7,13,21", "HTF 3 Sequence", group=grp_htf3)
i_htf3_anchor_mode = input.string("Manual", "HTF 3 Anchor Mode", options=["Manual", "Auto Pivot"], group=grp_htf3)
i_htf3_anchor_time = input.time(timestamp("2025-01-15 09:30"), "HTF 3 Manual Anchor", group=grp_htf3, confirm=true)

// ================================================
// 6. TIME DISTORTION
// ================================================
grp_td = "6. Time Distortion"
i_enable_td = input.bool(true, "Enable TD Detection", group=grp_td)
i_freeze_on_td = input.bool(true, "Freeze Count on TD", group=grp_td)
i_highlight_td = input.bool(true, "Highlight TD Zones", group=grp_td)
i_td_threshold = input.float(0.5, "TD Threshold", group=grp_td)

// ================================================
// 7. MULTIPLE CYCLES
// ================================================
grp_cycles = "7. Multiple Cycles"
i_enable_multiple = input.bool(true, "Enable Multiple Cycles", group=grp_cycles)
i_max_cycles = input.int(4, "Max Cycles", minval=1, maxval=10, group=grp_cycles)
i_auto_spawn = input.bool(true, "Auto Spawn at 7,13,21", group=grp_cycles)
i_show_overlaps = input.bool(true, "Show Overlaps", group=grp_cycles)

// ================================================
// 8. THE LINE (FVG)
// ================================================
grp_line = "8. THE LINE (FVG)"
i_enable_line = input.bool(true, "Enable THE LINE", group=grp_line)
i_line_max = input.int(5, "Max LINEs", minval=1, maxval=10, group=grp_line)
i_line_show_ltf = input.bool(true, "Show LTF LINEs", group=grp_line)
i_line_show_htf = input.bool(true, "Show HTF LINEs", group=grp_line)

// ================================================
// 9. ENHANCED ORDER BLOCKS
// ================================================
grp_eob = "9. Enhanced Order Blocks"
i_enable_eob = input.bool(true, "Enable EOB", group=grp_eob)
i_eob_max = input.int(3, "Max EOBs", minval=1, maxval=8, group=grp_eob)
i_eob_show_ltf = input.bool(true, "Show LTF EOBs", group=grp_eob)
i_eob_show_htf = input.bool(true, "Show HTF EOBs", group=grp_eob)

// ================================================
// 10. TRADING SIGNALS (From Photos)
// ================================================
grp_signals = "10. Trading Signals"
i_enable_signals = input.bool(true, "Enable Trade Signals", group=grp_signals)
i_entry_numbers = input.string("7,13,21", "Entry Sequence Numbers", group=grp_signals)
i_show_pyramid = input.bool(true, "Show Pyramid Entries", group=grp_signals)
i_pyramid_zones = input.string("13,21,31", "Pyramid at Numbers", group=grp_signals)
i_show_entry_zones = input.bool(true, "Draw Entry Zones", group=grp_signals)

// ================================================
// 11. ALIGNMENT DETECTION
// ================================================
grp_align = "11. HTF/LTF Alignment"
i_show_alignment = input.bool(true, "★ Show Alignment Stars", group=grp_align)
i_alignment_types = input.string("Both", "Alignment Type", options=["Same Number Only", "Both on Sequence", "Both"], group=grp_align)

// ================================================
// 12. TDT CASTING
// ================================================
grp_cast = "12. TDT Casting"
i_enable_casting = input.bool(false, "Enable Casting", group=grp_cast)
i_backward_seq = input.string("33,27,21,13,7,3,1", "Backward Sequence", group=grp_cast)
i_forward_cast_seq = input.string("1,3,7,13,21,27,33", "Forward Sequence", group=grp_cast)

// ================================================
// 13. VISUALS
// ================================================
grp_vis = "13. Visuals"
i_label_size = input.string("normal", "Label Size", options=["tiny", "small", "normal", "large"], group=grp_vis)
i_ltf_color = input.color(color.red, "LTF Color", group=grp_vis)
i_htf1_color = input.color(color.orange, "HTF 1 Color", group=grp_vis)
i_htf2_color = input.color(color.purple, "HTF 2 Color", group=grp_vis)
i_htf3_color = input.color(color.teal, "HTF 3 Color", group=grp_vis)
i_align_color = input.color(color.yellow, "Alignment Color", group=grp_vis)
i_entry_color = input.color(color.lime, "Entry Signal Color", group=grp_vis)
i_pyramid_color = input.color(color.aqua, "Pyramid Color", group=grp_vis)

// ================================================
// TYPES
// ================================================
type CycleData
    int start_bar
    int count
    bool active
    int cycle_id
    int last_count_bar  // Track last bar we counted
    bool is_bullish     // Cycle direction
    float anchor_price  // Starting price to validate progression

type LineData
    line line_id
    float level
    bool is_bullish
    bool is_mitigated

type EOBData
    box box_id
    float high_level
    float low_level
    bool is_bullish
    bool is_mitigated

// ================================================
// VARIABLES
// ================================================
var array<CycleData> active_cycles = array.new<CycleData>()
var array<LineData> active_lines = array.new<LineData>()
var array<EOBData> active_eobs = array.new<EOBData>()

// LTF
var bool ltf_counting = false
var int ltf_anchor_bar = na
var int ltf_last_seq_bar = na
var float ltf_last_seq_price = na
var line[] ltf_lines = array.new<line>()
var bool ltf_is_bullish_wave = true

// HTF1
var bool htf1_counting = false
var int htf1_count = 0
var int htf1_last_time = 0
var int htf1_last_bar = na
var float htf1_last_price = na
var line[] htf1_lines = array.new<line>()
var bool htf1_is_bullish = true
var float htf1_anchor_price = na

// HTF2
var bool htf2_counting = false
var int htf2_count = 0
var int htf2_last_time = 0
var int htf2_last_bar = na
var float htf2_last_price = na
var line[] htf2_lines = array.new<line>()
var bool htf2_is_bullish = true
var float htf2_anchor_price = na

// HTF3
var bool htf3_counting = false
var int htf3_count = 0
var int htf3_last_time = 0
var bool htf3_is_bullish = true
var float htf3_anchor_price = na
var int htf3_last_time = 0

// Casting
var bool casting_active = false
var bool casting_negative = true
var int backward_count = 0
var int forward_count = 0

// ================================================
// HELPER FUNCTIONS
// ================================================
f_parse(string s) =>
    arr = array.new<float>()
    parts = str.split(s, ",")
    for p in parts
        val = str.tonumber(str.trim(p))
        if not na(val)
            array.push(arr, val)
    arr

f_in_seq(int n, array<float> seq) =>
    array.includes(seq, float(n))

f_get_size(string s) =>
    switch s
        "tiny" => size.tiny
        "small" => size.small
        "large" => size.large
        => size.normal

f_get_cycle_color(int idx) =>
    switch idx
        0 => i_ltf_color
        1 => color.green
        2 => color.blue
        3 => color.fuchsia
        => color.gray

f_is_td() =>
    if not i_enable_td
        false
    else
        candle_range = high - low
        body = math.abs(close - open)
        avg = ta.sma(high - low, 20)
        is_inside = high <= high[1] and low >= low[1]
        is_small = candle_range > 0 and (body / candle_range) < 0.3
        is_consol = candle_range < avg * i_td_threshold
        is_inside or is_small or is_consol

f_should_count() =>
    if i_counting_direction == "Neutral"
        true
    else if i_counting_direction == "Bullish"
        close >= open
    else
        close <= open

f_detect_fvg() =>
    if bar_index < 2
        [false, float(na), false]
    else
        is_bull = low[0] > high[2]
        is_bear = high[0] < low[2]
        level = float(na)
        valid = false
        if is_bull
            level := high[2]
            valid := true
        else if is_bear
            level := low[2]
            valid := true
        [valid, level, is_bull]

f_detect_eob() =>
    if bar_index < 1
        [false, float(na), float(na), false]
    else
        is_bear = (close[1] > open[1]) and (close < open[1]) and (low < low[1])
        is_bull = (close[1] < open[1]) and (close > open[1]) and (high > high[1])
        eob_h = float(na)
        eob_l = float(na)
        valid = false
        if is_bear
            eob_h := high[1]
            eob_l := low[1]
            valid := true
        else if is_bull
            eob_h := high[1]
            eob_l := low[1]
            valid := true
        [valid, eob_h, eob_l, is_bull]

// Parse sequences
main_seq = f_parse(i_main_sequence)
htf1_seq = f_parse(i_htf1_sequence)
htf2_seq = f_parse(i_htf2_sequence)
htf3_seq = f_parse(i_htf3_sequence)
entry_seq = f_parse(i_entry_numbers)
pyramid_seq = f_parse(i_pyramid_zones)
backward_seq = f_parse(i_backward_seq)
forward_seq = f_parse(i_forward_cast_seq)

atr_val = ta.atr(14)
label_size = f_get_size(i_label_size)

// ================================================
// LTF ANCHOR DETECTION (SMART) - FIXED
// ================================================
// Detect pivot, then wait for EXPANSION candle to start counting
pivot_l = ta.pivotlow(low, i_ltf_auto_pivot_left, i_ltf_auto_pivot_right)
pivot_h = ta.pivothigh(high, i_ltf_auto_pivot_left, i_ltf_auto_pivot_right)

// State: waiting for pivot, or waiting for expansion after pivot
var bool waiting_for_expansion = false
var bool expansion_should_be_bullish = false
var int pivot_detected_bar = na

// Check for significant pivot
is_significant_pivot = false
pivot_is_bullish = false

if not na(pivot_l)
    recent_low = ta.lowest(low, 50)
    pivot_strength = (high - low[i_ltf_auto_pivot_right]) / atr_val
    if low[i_ltf_auto_pivot_right] <= recent_low * 1.005 and pivot_strength > 1.5
        is_significant_pivot := true
        pivot_is_bullish := true

if not na(pivot_h)
    recent_high = ta.highest(high, 50)
    pivot_strength = (high[i_ltf_auto_pivot_right] - low) / atr_val
    if high[i_ltf_auto_pivot_right] >= recent_high * 0.995 and pivot_strength > 1.5
        is_significant_pivot := true
        pivot_is_bullish := false

// Manual anchor
if not ltf_counting and not waiting_for_expansion
    if i_ltf_anchor_mode == "Manual"
        if time >= i_ltf_anchor_time
            ltf_anchor_bar := bar_index
            ltf_counting := true
            // DETECT direction from candle body
            ltf_is_bullish_wave := close > open
            if i_enable_multiple
                // Set anchor based on direction
                anchor_level_ltf = ltf_is_bullish_wave ? low : high
                array.push(active_cycles, CycleData.new(ltf_anchor_bar, 1, true, 0, ltf_anchor_bar, ltf_is_bullish_wave, anchor_level_ltf))
            label_style_ltf = ltf_is_bullish_wave ? label.style_label_up : label.style_label_down
            label_y_ltf = ltf_is_bullish_wave ? low - atr_val * 0.3 : high + atr_val * 0.3
            label.new(ltf_anchor_bar, label_y_ltf, "1", color=color.new(color.white, 100), textcolor=i_ltf_color, style=label_style_ltf, size=label_size)
            ltf_last_seq_bar := ltf_anchor_bar
            ltf_last_seq_price := ltf_is_bullish_wave ? low : high
    else
        // Auto mode - detect pivot, then wait for expansion
        if is_significant_pivot
            waiting_for_expansion := true
            expansion_should_be_bullish := pivot_is_bullish
            pivot_detected_bar := bar_index

// Waiting for expansion candle after pivot
if waiting_for_expansion and not ltf_counting
    // Check if current candle is the expansion candle
    is_expansion_candle = false
    
    if expansion_should_be_bullish
        // Need bullish candle after low pivot
        if close > open and (high - low) > atr_val * 0.5
            is_expansion_candle := true
            ltf_is_bullish_wave := true
    else
        // Need bearish candle after high pivot
        if close < open and (high - low) > atr_val * 0.5
            is_expansion_candle := true
            ltf_is_bullish_wave := false
    
    if is_expansion_candle
        // THIS is where we start counting from "1"
        ltf_anchor_bar := bar_index
        ltf_counting := true
        waiting_for_expansion := false
        
        if i_enable_multiple
            cycle_direction = expansion_should_be_bullish
            // Set anchor: bullish=LOW, bearish=HIGH
            anchor_level = cycle_direction ? low : high
            array.push(active_cycles, CycleData.new(ltf_anchor_bar, 1, true, 0, ltf_anchor_bar, cycle_direction, anchor_level))
        
        pivot_style = expansion_should_be_bullish ? label.style_label_up : label.style_label_down
        label_y = expansion_should_be_bullish ? low - atr_val * 0.3 : high + atr_val * 0.3
        label.new(ltf_anchor_bar, label_y, "1", color=color.new(color.white, 100), textcolor=i_ltf_color, style=pivot_style, size=label_size)
        ltf_last_seq_bar := ltf_anchor_bar
        ltf_last_seq_price := expansion_should_be_bullish ? low : high

// ================================================
// LTF COUNTING & MULTIPLE CYCLES
// ================================================
is_td = f_is_td()
bgcolor(is_td and i_highlight_td ? color.new(color.yellow, 90) : na)

// Check structure - but DON'T reset on retracements
if ltf_counting and array.size(active_cycles) > 0
    main_cycle = array.get(active_cycles, 0)
    
    // Wave continues until 31 or major opposite pivot
    if ltf_is_bullish_wave
        if close < ta.lowest(low, 20) and close < open
            ltf_is_bullish_wave := ltf_is_bullish_wave
    else
        if close > ta.highest(high, 20) and close > open
            ltf_is_bullish_wave := ltf_is_bullish_wave

if ltf_counting and bar_index >= ltf_anchor_bar and i_enable_multiple
    should_count = f_should_count()
    should_freeze = is_td and i_freeze_on_td
    
    if should_count and not should_freeze
        for i = 0 to array.size(active_cycles) - 1
            cycle = array.get(active_cycles, i)
            // ONLY count if we haven't counted this bar yet!
            if cycle.active and bar_index >= cycle.start_bar and bar_index != cycle.last_count_bar
                // VALIDATE: Cycle must NOT break structure
                is_valid = true
                if cycle.is_bullish
                    // Bullish cycle: LOW must stay ABOVE anchor (no lower low)
                    if low < cycle.anchor_price
                        is_valid := false
                else
                    // Bearish cycle: HIGH must stay BELOW anchor (no higher high)
                    if high > cycle.anchor_price
                        is_valid := false
                
                if is_valid
                    new_count = cycle.count + 1
                    cycle.count := new_count
                    cycle.last_count_bar := bar_index
                    array.set(active_cycles, i, cycle)
                    
                    is_seq = f_in_seq(new_count, main_seq)
                    if is_seq
                        cycle_color = f_get_cycle_color(i)
                        y_offset = atr_val * (0.5 + i * 0.4)
                        label_y = high + y_offset
                        
                        // Check overlaps
                        overlap = ""
                        for j = 0 to array.size(active_cycles) - 1
                            if j != i
                                other = array.get(active_cycles, j)
                                if other.count == new_count and i_show_overlaps
                                    overlap := overlap + "C" + str.tostring(j+1) + " "
                        
                        label_text = str.tostring(new_count)
                        if overlap != ""
                            label_text := label_text + "\n(" + overlap + ")"
                        
                        label.new(bar_index, label_y, label_text, color=color.new(color.white, 100), textcolor=cycle_color, style=label.style_label_down, size=label_size)
                        
                        // Connect lines (like NASDAQ photo)
                        if i_show_ltf_lines and not na(ltf_last_seq_bar) and i == 0
                            // Use correct price level for direction
                            current_seq_price = cycle.is_bullish ? high : low
                            new_line = line.new(ltf_last_seq_bar, ltf_last_seq_price, bar_index, current_seq_price, color=cycle_color, width=2)
                            array.push(ltf_lines, new_line)
                            if array.size(ltf_lines) > 10
                                old = array.shift(ltf_lines)
                                line.delete(old)
                        
                        if i == 0
                            ltf_last_seq_bar := bar_index
                            ltf_last_seq_price := cycle.is_bullish ? high : low
                    
                    // Auto spawn - new cycle inherits parent direction
                    if i_auto_spawn and (new_count == 7 or new_count == 13 or new_count == 21)
                        if array.size(active_cycles) < i_max_cycles
                            // New cycle starts at 1, same direction
                            spawn_anchor = cycle.is_bullish ? low : high
                            array.push(active_cycles, CycleData.new(bar_index, 1, true, array.size(active_cycles), bar_index, cycle.is_bullish, spawn_anchor))
                    
                    // Restart
                    if new_count >= 31
                        cycle.count := 0
                        cycle.start_bar := bar_index
                        array.set(active_cycles, i, cycle)
                else
                    // Cycle invalidated - stop counting
                    cycle.active := false
                    array.set(active_cycles, i, cycle)

// Get current LTF count
current_ltf_count = 0
if array.size(active_cycles) > 0
    main_cycle = array.get(active_cycles, 0)
    current_ltf_count := main_cycle.count

// ================================================
// HTF 1 COUNTING
// ================================================
htf1_time = request.security(syminfo.tickerid, i_htf1, time)
htf1_pivot_l = request.security(syminfo.tickerid, i_htf1, ta.pivotlow(low, i_ltf_auto_pivot_left, i_ltf_auto_pivot_right))
htf1_pivot_h = request.security(syminfo.tickerid, i_htf1, ta.pivothigh(high, i_ltf_auto_pivot_left, i_ltf_auto_pivot_right))

if i_enable_htf1 and not htf1_counting
    if i_htf1_anchor_mode == "Manual"
        if time >= i_htf1_anchor_time
            htf1_counting := true
            htf1_count := 1
            htf1_last_bar := bar_index
            // Detect direction
            htf1_is_bullish := close > open
            htf1_anchor_price := htf1_is_bullish ? low : high
            htf1_last_price := htf1_anchor_price
            label_style_h1 = htf1_is_bullish ? label.style_label_up : label.style_label_down
            label_y_h1 = htf1_is_bullish ? low - atr_val * 1.0 : high + atr_val * 1.0
            label.new(bar_index, label_y_h1, i_htf1 + ":1", color=color.new(color.white, 100), textcolor=i_htf1_color, style=label_style_h1, size=size.small)
    else
        if not na(htf1_pivot_l)
            htf1_counting := true
            htf1_count := 1
            htf1_last_bar := bar_index
            htf1_is_bullish := true
            htf1_anchor_price := low
            htf1_last_price := low
            label.new(bar_index, low - atr_val * 1.0, i_htf1 + ":1", color=color.new(color.white, 100), textcolor=i_htf1_color, style=label.style_label_up, size=size.small)
        else if not na(htf1_pivot_h)
            htf1_counting := true
            htf1_count := 1
            htf1_last_bar := bar_index
            htf1_is_bullish := false
            htf1_anchor_price := high
            htf1_last_price := high
            label.new(bar_index, high + atr_val * 1.0, i_htf1 + ":1", color=color.new(color.white, 100), textcolor=i_htf1_color, style=label.style_label_down, size=size.small)

if i_enable_htf1 and htf1_counting and htf1_time != htf1_last_time
    htf1_last_time := htf1_time
    
    // VALIDATE: Structure must NOT break
    is_htf1_valid = true
    if htf1_is_bullish
        // Bullish: LOW must stay ABOVE anchor
        if low < htf1_anchor_price
            is_htf1_valid := false
            htf1_counting := false  // Stop counting
    else
        // Bearish: HIGH must stay BELOW anchor
        if high > htf1_anchor_price
            is_htf1_valid := false
            htf1_counting := false  // Stop counting
    
    if is_htf1_valid
        htf1_count := htf1_count + 1
    
    if is_htf1_valid and f_in_seq(htf1_count, htf1_seq)
        y_pos = low - atr_val * 1.0
        
        // Alignment detection
        is_same_number = current_ltf_count == htf1_count and ltf_counting
        ltf_on_seq = f_in_seq(current_ltf_count, main_seq)
        is_both_seq = ltf_on_seq
        
        show_star = false
        star_type = ""
        if i_show_alignment
            if i_alignment_types == "Same Number Only" and is_same_number
                show_star := true
                star_type := "SAME"
            else if i_alignment_types == "Both on Sequence" and is_both_seq
                show_star := true
                star_type := "BOTH"
            else if i_alignment_types == "Both" and (is_same_number or is_both_seq)
                show_star := true
                star_type := is_same_number ? "SAME" : "BOTH"
        
        label_color = show_star ? i_align_color : i_htf1_color
        label.new(bar_index, y_pos, i_htf1 + ":" + str.tostring(htf1_count), color=color.new(color.white, 100), textcolor=label_color, style=label.style_label_up, size=show_star ? size.normal : size.small)
        
        if show_star
            star_text = star_type == "SAME" ? ("★★★ " + str.tostring(htf1_count) + " ★★★") : "★"
            star_size = star_type == "SAME" ? size.huge : size.normal
            label.new(bar_index, high + atr_val * 0.3, star_text, color=i_align_color, textcolor=color.black, style=label.style_label_down, size=star_size)
        
        // Connect lines
        if i_show_htf1_lines and not na(htf1_last_bar)
            current_htf1_price = htf1_is_bullish ? high : low
            new_line = line.new(htf1_last_bar, htf1_last_price, bar_index, current_htf1_price, color=i_htf1_color, width=1, style=line.style_dashed)
            array.push(htf1_lines, new_line)
            if array.size(htf1_lines) > 10
                old = array.shift(htf1_lines)
                line.delete(old)
        
        htf1_last_bar := bar_index
        htf1_last_price := htf1_is_bullish ? high : low
    
    if htf1_count >= 31
        htf1_count := 0
        htf1_last_bar := na

// ================================================
// HTF 2 COUNTING
// ================================================
htf2_time = request.security(syminfo.tickerid, i_htf2, time)
htf2_pivot_l = request.security(syminfo.tickerid, i_htf2, ta.pivotlow(low, i_ltf_auto_pivot_left, i_ltf_auto_pivot_right))
htf2_pivot_h = request.security(syminfo.tickerid, i_htf2, ta.pivothigh(high, i_ltf_auto_pivot_left, i_ltf_auto_pivot_right))

if i_enable_htf2 and not htf2_counting
    if i_htf2_anchor_mode == "Manual"
        if time >= i_htf2_anchor_time
            htf2_counting := true
            htf2_count := 1
            htf2_last_bar := bar_index
            htf2_is_bullish := close > open
            htf2_anchor_price := htf2_is_bullish ? low : high
            htf2_last_price := htf2_anchor_price
            label_style_h2 = htf2_is_bullish ? label.style_label_up : label.style_label_down
            label_y_h2 = htf2_is_bullish ? low - atr_val * 1.5 : high + atr_val * 1.5
            label.new(bar_index, label_y_h2, i_htf2 + ":1", color=color.new(color.white, 100), textcolor=i_htf2_color, style=label_style_h2, size=size.small)
    else
        if not na(htf2_pivot_l)
            htf2_counting := true
            htf2_count := 1
            htf2_last_bar := bar_index
            htf2_is_bullish := true
            htf2_anchor_price := low
            htf2_last_price := low
            label.new(bar_index, low - atr_val * 1.5, i_htf2 + ":1", color=color.new(color.white, 100), textcolor=i_htf2_color, style=label.style_label_up, size=size.small)
        else if not na(htf2_pivot_h)
            htf2_counting := true
            htf2_count := 1
            htf2_last_bar := bar_index
            htf2_is_bullish := false
            htf2_anchor_price := high
            htf2_last_price := high
            label.new(bar_index, high + atr_val * 1.5, i_htf2 + ":1", color=color.new(color.white, 100), textcolor=i_htf2_color, style=label.style_label_down, size=size.small)

if i_enable_htf2 and htf2_counting and htf2_time != htf2_last_time
    htf2_last_time := htf2_time
    
    // VALIDATE: Structure must NOT break
    is_htf2_valid = true
    if htf2_is_bullish
        if low < htf2_anchor_price
            is_htf2_valid := false
            htf2_counting := false
    else
        if high > htf2_anchor_price
            is_htf2_valid := false
            htf2_counting := false
    
    if is_htf2_valid
        htf2_count := htf2_count + 1
    
    if is_htf2_valid and f_in_seq(htf2_count, htf2_seq)
        y_pos = low - atr_val * 1.5
        
        is_same_number = current_ltf_count == htf2_count and ltf_counting
        ltf_on_seq = f_in_seq(current_ltf_count, main_seq)
        is_both_seq = ltf_on_seq
        
        show_star = false
        star_type = ""
        if i_show_alignment
            if i_alignment_types == "Same Number Only" and is_same_number
                show_star := true
                star_type := "SAME"
            else if i_alignment_types == "Both on Sequence" and is_both_seq
                show_star := true
                star_type := "BOTH"
            else if i_alignment_types == "Both" and (is_same_number or is_both_seq)
                show_star := true
                star_type := is_same_number ? "SAME" : "BOTH"
        
        label_color = show_star ? i_align_color : i_htf2_color
        label.new(bar_index, y_pos, i_htf2 + ":" + str.tostring(htf2_count), color=color.new(color.white, 100), textcolor=label_color, style=label.style_label_up, size=show_star ? size.normal : size.small)
        
        if show_star
            star_text = star_type == "SAME" ? ("★★★ " + str.tostring(htf2_count) + " ★★★") : "★"
            star_size = star_type == "SAME" ? size.huge : size.normal
            label.new(bar_index, high + atr_val * 0.6, star_text, color=i_align_color, textcolor=color.black, style=label.style_label_down, size=star_size)
        
        if i_show_htf2_lines and not na(htf2_last_bar)
            current_htf2_price = htf2_is_bullish ? high : low
            new_line = line.new(htf2_last_bar, htf2_last_price, bar_index, current_htf2_price, color=i_htf2_color, width=1, style=line.style_dotted)
            array.push(htf2_lines, new_line)
            if array.size(htf2_lines) > 10
                old = array.shift(htf2_lines)
                line.delete(old)
        
        htf2_last_bar := bar_index
        htf2_last_price := htf2_is_bullish ? high : low
    
    if htf2_count >= 31
        htf2_count := 0
        htf2_last_bar := na

// ================================================
// HTF 3 COUNTING
// ================================================
htf3_time = request.security(syminfo.tickerid, i_htf3, time)

if i_enable_htf3 and not htf3_counting
    if i_htf3_anchor_mode == "Manual"
        if time >= i_htf3_anchor_time
            htf3_counting := true
            htf3_count := 1
            htf3_is_bullish := close > open
            htf3_anchor_price := htf3_is_bullish ? low : high
            label_style_h3 = htf3_is_bullish ? label.style_label_up : label.style_label_down
            label_y_h3 = htf3_is_bullish ? low - atr_val * 2.0 : high + atr_val * 2.0
            label.new(bar_index, label_y_h3, i_htf3 + ":1", color=color.new(color.white, 100), textcolor=i_htf3_color, style=label_style_h3, size=size.small)

if i_enable_htf3 and htf3_counting and htf3_time != htf3_last_time
    htf3_last_time := htf3_time
    
    // VALIDATE: Structure must NOT break
    is_htf3_valid = true
    if htf3_is_bullish
        if low < htf3_anchor_price
            is_htf3_valid := false
            htf3_counting := false
    else
        if high > htf3_anchor_price
            is_htf3_valid := false
            htf3_counting := false
    
    if is_htf3_valid
        htf3_count := htf3_count + 1
    
    if is_htf3_valid and f_in_seq(htf3_count, htf3_seq)
        y_pos = low - atr_val * 2.0
        is_same = current_ltf_count == htf3_count and ltf_counting
        label_color = is_same and i_show_alignment ? i_align_color : i_htf3_color
        label.new(bar_index, y_pos, i_htf3 + ":" + str.tostring(htf3_count), color=color.new(color.white, 100), textcolor=label_color, style=label.style_label_up, size=is_same ? size.normal : size.small)
    
    if htf3_count >= 31
        htf3_count := 0

// ================================================
// TRADING SIGNALS - ONLY WHEN HTF+LTF BOTH ON SEQUENCE
// ================================================
if i_enable_signals and ltf_counting and current_ltf_count > 0
    // Check if LTF is on sequence
    ltf_on_sequence = f_in_seq(current_ltf_count, entry_seq)
    
    // Check if ANY HTF is on sequence
    htf1_on_sequence = htf1_counting and f_in_seq(htf1_count, htf1_seq)
    htf2_on_sequence = htf2_counting and f_in_seq(htf2_count, htf2_seq)
    htf3_on_sequence = htf3_counting and f_in_seq(htf3_count, htf3_seq)
    
    any_htf_on_sequence = htf1_on_sequence or htf2_on_sequence or htf3_on_sequence
    
    // ONLY show entry if BOTH LTF and HTF are on sequence (any numbers)
    if ltf_on_sequence and any_htf_on_sequence
        // Determine which HTFs are aligned
        htf_text = ""
        if htf1_on_sequence
            htf_text := htf_text + i_htf1 + ":" + str.tostring(htf1_count) + " "
        if htf2_on_sequence
            htf_text := htf_text + i_htf2 + ":" + str.tostring(htf2_count) + " "
        if htf3_on_sequence
            htf_text := htf_text + i_htf3 + ":" + str.tostring(htf3_count)
        
        entry_text = "ENTRY\nLTF:" + str.tostring(current_ltf_count) + "\n" + htf_text
        label.new(bar_index, low - atr_val * 0.5, entry_text, color=i_entry_color, textcolor=color.black, style=label.style_triangleup, size=size.normal)
        
        // Draw entry zone
        if i_show_entry_zones
            box.new(bar_index, high, bar_index + 5, low, border_color=i_entry_color, bgcolor=color.new(i_entry_color, 90), extend=extend.right)
    
    // Pyramid entries - also require HTF+LTF alignment
    is_pyramid = f_in_seq(current_ltf_count, pyramid_seq)
    if is_pyramid and i_show_pyramid and any_htf_on_sequence
        label.new(bar_index, low - atr_val * 0.8, "ADD\n" + str.tostring(current_ltf_count), color=i_pyramid_color, textcolor=color.black, style=label.style_triangleup, size=size.small)

// ================================================
// THE LINE (FVG)
// ================================================
if i_enable_line and i_line_show_ltf
    [is_fvg, fvg_level, is_bull] = f_detect_fvg()
    
    if is_fvg and not na(fvg_level)
        while array.size(active_lines) >= i_line_max
            old = array.shift(active_lines)
            line.delete(old.line_id)
        
        new_line = line.new(bar_index, fvg_level, bar_index+1, fvg_level, extend=extend.right, color=is_bull ? color.aqua : color.orange, width=1)
        array.push(active_lines, LineData.new(new_line, fvg_level, is_bull, false))
    
    // Mitigation
    if array.size(active_lines) > 0
        for i = 0 to array.size(active_lines) - 1
            if i < array.size(active_lines)
                line_data = array.get(active_lines, i)
                if not line_data.is_mitigated
                    mitigated = line_data.is_bullish ? (low <= line_data.level) : (high >= line_data.level)
                    if mitigated
                        line_data.is_mitigated := true
                        array.set(active_lines, i, line_data)
                        line.set_extend(line_data.line_id, extend.none)
                        line.set_xy2(line_data.line_id, bar_index, line_data.level)
                        line.set_color(line_data.line_id, color.gray)

// ================================================
// EOB
// ================================================
if i_enable_eob and i_eob_show_ltf
    [is_eob, eob_h, eob_l, is_bull] = f_detect_eob()
    
    if is_eob and not na(eob_h)
        while array.size(active_eobs) >= i_eob_max
            old = array.shift(active_eobs)
            box.delete(old.box_id)
        
        eob_color = is_bull ? color.new(color.green, 80) : color.new(color.red, 80)
        new_box = box.new(bar_index, eob_h, bar_index+1, eob_l, extend=extend.right, border_color=eob_color, bgcolor=eob_color)
        array.push(active_eobs, EOBData.new(new_box, eob_h, eob_l, is_bull, false))
    
    // Mitigation
    if array.size(active_eobs) > 0
        for i = 0 to array.size(active_eobs) - 1
            if i < array.size(active_eobs)
                eob_data = array.get(active_eobs, i)
                if not eob_data.is_mitigated
                    mitigated = eob_data.is_bullish ? (close < eob_data.high_level) : (close > eob_data.low_level)
                    if mitigated
                        eob_data.is_mitigated := true
                        array.set(active_eobs, i, eob_data)
                        box.set_extend(eob_data.box_id, extend.none)
                        box.set_right(eob_data.box_id, bar_index)
                        box.set_bgcolor(eob_data.box_id, color.new(color.gray, 90))

// ================================================
// STATUS TABLE
// ================================================
if barstate.islast
    var table t = table.new(position.top_right, 2, 9, bgcolor=color.new(color.white, 85), border_width=1)
    
    table.cell(t, 0, 0, "TDT MEGA", bgcolor=color.new(color.blue, 70), text_color=color.white, text_size=size.normal)
    table.cell(t, 1, 0, "", bgcolor=color.new(color.blue, 70))
    
    table.cell(t, 0, 1, "LTF Count", text_size=size.tiny)
    table.cell(t, 1, 1, ltf_counting ? str.tostring(current_ltf_count) : "Wait", text_color=ltf_counting ? color.green : color.gray, text_size=size.tiny)
    
    table.cell(t, 0, 2, "Cycles", text_size=size.tiny)
    table.cell(t, 1, 2, str.tostring(array.size(active_cycles)), text_size=size.tiny)
    
    table.cell(t, 0, 3, "TD", text_size=size.tiny)
    table.cell(t, 1, 3, is_td ? "⚠" : "✓", text_color=is_td ? color.orange : color.green, text_size=size.tiny)
    
    table.cell(t, 0, 4, i_htf1, text_size=size.tiny)
    table.cell(t, 1, 4, htf1_counting ? str.tostring(htf1_count) : "-", text_color=i_htf1_color, text_size=size.tiny)
    
    table.cell(t, 0, 5, i_htf2, text_size=size.tiny)
    table.cell(t, 1, 5, htf2_counting ? str.tostring(htf2_count) : "-", text_color=i_htf2_color, text_size=size.tiny)
    
    table.cell(t, 0, 6, i_htf3, text_size=size.tiny)
    table.cell(t, 1, 6, htf3_counting ? str.tostring(htf3_count) : "-", text_color=i_htf3_color, text_size=size.tiny)
    
    is_aligned = ((current_ltf_count == htf1_count) or (current_ltf_count == htf2_count) or (current_ltf_count == htf3_count)) and ltf_counting
    table.cell(t, 0, 7, "Aligned", text_size=size.tiny)
    table.cell(t, 1, 7, is_aligned ? "★ YES" : "NO", text_color=is_aligned ? i_align_color : color.gray, text_size=size.tiny)
    
    table.cell(t, 0, 8, "LINEs/EOBs", text_size=size.tiny)
    table.cell(t, 1, 8, str.tostring(array.size(active_lines)) + "/" + str.tostring(array.size(active_eobs)), text_size=size.tiny)

// ================================================
// ALERTS
// ================================================
if ltf_counting and f_in_seq(current_ltf_count, main_seq)
    alert("TDT: LTF Sequence " + str.tostring(current_ltf_count), alert.freq_once_per_bar)

// Golden alignment - same number
if ltf_counting and ((current_ltf_count == htf1_count) or (current_ltf_count == htf2_count))
    alert("★★★ GOLDEN ALIGNMENT at " + str.tostring(current_ltf_count), alert.freq_once_per_bar)

// Entry signal - ONLY when both HTF and LTF on sequence
if i_enable_signals and ltf_counting
    ltf_on_seq = f_in_seq(current_ltf_count, entry_seq)
    htf1_on_seq = htf1_counting and f_in_seq(htf1_count, htf1_seq)
    htf2_on_seq = htf2_counting and f_in_seq(htf2_count, htf2_seq)
    htf3_on_seq = htf3_counting and f_in_seq(htf3_count, htf3_seq)
    any_htf_on_seq = htf1_on_seq or htf2_on_seq or htf3_on_seq
    
    if ltf_on_seq and any_htf_on_seq
        alert("🎯 ENTRY: LTF=" + str.tostring(current_ltf_count) + " + HTF aligned", alert.freq_once_per_bar)
