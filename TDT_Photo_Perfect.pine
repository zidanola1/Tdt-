//@version=5
indicator("TDT Photo Perfect", shorttitle="TDT Perfect", overlay=true, max_labels_count=500, max_lines_count=500, max_boxes_count=100)

// ========================================
// SETTINGS
// ========================================
// Core
i_sequence = input.string("1,3,7,13,21,31,43", "Sequence", group="Core")
i_direction = input.string("Auto", "Direction", options=["Auto", "Bullish", "Bearish"], group="Core", tooltip="Auto detects from pivot")

// Auto Detection
grp_auto = "Auto Detection"
i_pivot_left = input.int(5, "Pivot Bars Left", minval=2, group=grp_auto)
i_pivot_right = input.int(5, "Pivot Bars Right", minval=2, group=grp_auto)
i_min_pivot_strength = input.float(1.5, "Min Pivot Strength", minval=1.0, group=grp_auto, tooltip="How strong pivot must be vs average")
i_breakout_confirm = input.bool(true, "Require Breakout Confirmation", group=grp_auto)

// Multi-Timeframe
grp_mtf = "Multi-Timeframe"
i_enable_htf1 = input.bool(true, "HTF 1", group=grp_mtf)
i_htf1 = input.timeframe("60", "Timeframe 1", group=grp_mtf)
i_enable_htf2 = input.bool(true, "HTF 2", group=grp_mtf)
i_htf2 = input.timeframe("240", "Timeframe 2", group=grp_mtf)

// Visuals
grp_vis = "Visuals"
i_show_lines = input.bool(true, "Connect Sequence Lines", group=grp_vis, tooltip="Draw lines between sequence numbers like in photos")
i_show_td = input.bool(true, "Show Time Distortion", group=grp_vis)
i_label_size = input.string("normal", "Label Size", options=["small", "normal", "large"], group=grp_vis)
i_main_color = input.color(color.red, "Main Color", group=grp_vis)
i_htf_color = input.color(color.orange, "HTF Color", group=grp_vis)

// ========================================
// VARIABLES
// ========================================
var int anchor_bar = na
var int last_seq_bar = na
var float last_seq_price = na
var bool counting = false
var int count = 0
var bool is_bullish = true

var int htf1_anchor = na
var int htf1_count = 0
var int htf1_last_time = 0
var bool htf1_counting = false
var int htf1_last_bar = na
var float htf1_last_price = na

var int htf2_anchor = na
var int htf2_count = 0
var int htf2_last_time = 0
var bool htf2_counting = false
var int htf2_last_bar = na
var float htf2_last_price = na

var line[] sequence_lines = array.new<line>()

// ========================================
// FUNCTIONS
// ========================================
f_parse_seq(string s) =>
    arr = array.new<float>()
    parts = str.split(s, ",")
    for p in parts
        val = str.tonumber(str.trim(p))
        if not na(val)
            array.push(arr, val)
    arr

f_in_seq(int n, array<float> seq) =>
    array.includes(seq, float(n))

f_get_size(string s) =>
    switch s
        "small" => size.small
        "large" => size.large
        => size.normal

f_is_strong_pivot(float pivot_price, bool is_low) =>
    atr = ta.atr(14)
    avg_range = ta.sma(high - low, 20)
    
    if is_low
        pivot_strength = (ta.highest(high, 20) - pivot_price) / atr
    else
        pivot_strength = (pivot_price - ta.lowest(low, 20)) / atr
    
    pivot_strength > i_min_pivot_strength

f_is_td() =>
    if not i_show_td
        false
    else
        range = high - low
        body = math.abs(close - open)
        avg = ta.sma(high - low, 20)
        
        is_inside = high <= high[1] and low >= low[1]
        is_small = range > 0 and (body / range) < 0.3
        is_consol = range < avg * 0.5
        
        is_inside or is_small or is_consol

// ========================================
// PARSE SEQUENCE
// ========================================
seq = f_parse_seq(i_sequence)
atr_val = ta.atr(14)
label_size = f_get_size(i_label_size)

// ========================================
// AUTO DETECT ANCHOR - LTF
// ========================================
pivot_low = ta.pivotlow(low, i_pivot_left, i_pivot_right)
pivot_high = ta.pivothigh(high, i_pivot_left, i_pivot_right)

// Auto start from strong pivot
if not counting
    if not na(pivot_low) and f_is_strong_pivot(low[i_pivot_right], true)
        // Bullish pivot detected
        if i_direction == "Auto" or i_direction == "Bullish"
            confirm = true
            if i_breakout_confirm
                // Check if we broke above recent high
                confirm := high > ta.highest(high[1], 10)
            
            if confirm
                anchor_bar := bar_index - i_pivot_right
                counting := true
                is_bullish := true
                count := 0
                
    else if not na(pivot_high) and f_is_strong_pivot(high[i_pivot_right], false)
        // Bearish pivot detected
        if i_direction == "Auto" or i_direction == "Bearish"
            confirm = true
            if i_breakout_confirm
                confirm := low < ta.lowest(low[1], 10)
            
            if confirm
                anchor_bar := bar_index - i_pivot_right
                counting := true
                is_bullish := false
                count := 0

// ========================================
// COUNTING
// ========================================
is_td = f_is_td()
bgcolor(is_td and i_show_td ? color.new(color.yellow, 90) : na)

if counting and bar_index >= anchor_bar
    if not is_td
        count := count + 1
    
    if f_in_seq(count, seq) and count > 0
        // Clean label like photos
        y_pos = is_bullish ? high + atr_val * 0.5 : low - atr_val * 0.5
        style = is_bullish ? label.style_label_down : label.style_label_up
        
        label.new(bar_index, y_pos, str.tostring(count), 
                 color=color.new(color.white, 100), 
                 textcolor=i_main_color, 
                 style=style, 
                 size=label_size)
        
        // Draw connecting line like NASDAQ photo
        if i_show_lines and not na(last_seq_bar)
            new_line = line.new(last_seq_bar, last_seq_price, bar_index, is_bullish ? high : low, 
                               color=i_main_color, 
                               width=1, 
                               style=line.style_solid)
            array.push(sequence_lines, new_line)
            
            // Keep only last 10 lines
            if array.size(sequence_lines) > 10
                old_line = array.shift(sequence_lines)
                line.delete(old_line)
        
        last_seq_bar := bar_index
        last_seq_price := is_bullish ? high : low
    
    // Restart at 31
    if count >= 31
        count := 0
        last_seq_bar := na

// ========================================
// HTF 1 AUTO DETECTION
// ========================================
htf1_time = request.security(syminfo.tickerid, i_htf1, time)
htf1_pivot_low = request.security(syminfo.tickerid, i_htf1, ta.pivotlow(low, i_pivot_left, i_pivot_right))
htf1_pivot_high = request.security(syminfo.tickerid, i_htf1, ta.pivothigh(high, i_pivot_left, i_pivot_right))

if i_enable_htf1 and not htf1_counting
    if not na(htf1_pivot_low)
        htf1_counting := true
        htf1_anchor := bar_index
        htf1_count := 0
    else if not na(htf1_pivot_high)
        htf1_counting := true
        htf1_anchor := bar_index
        htf1_count := 0

if i_enable_htf1 and htf1_counting and htf1_time != htf1_last_time
    htf1_last_time := htf1_time
    htf1_count := htf1_count + 1
    
    if f_in_seq(htf1_count, seq)
        y_pos = low - atr_val * 1.0
        
        // Check alignment
        is_aligned = count == htf1_count and counting
        label_color = is_aligned ? color.yellow : i_htf_color
        
        label.new(bar_index, y_pos, i_htf1 + ":" + str.tostring(htf1_count), 
                 color=color.new(color.white, 100), 
                 textcolor=label_color, 
                 style=label.style_label_up, 
                 size=is_aligned ? size.normal : size.small)
        
        // Golden star for alignment
        if is_aligned
            label.new(bar_index, high + atr_val * 0.3, "★ " + str.tostring(htf1_count) + " ★", 
                     color=color.yellow, 
                     textcolor=color.black, 
                     style=label.style_label_down, 
                     size=size.huge)
        
        // Connect HTF lines
        if i_show_lines and not na(htf1_last_bar)
            line.new(htf1_last_bar, htf1_last_price, bar_index, low, 
                    color=i_htf_color, 
                    width=1, 
                    style=line.style_dashed)
        
        htf1_last_bar := bar_index
        htf1_last_price := low
    
    if htf1_count >= 31
        htf1_count := 0
        htf1_last_bar := na

// ========================================
// HTF 2 AUTO DETECTION
// ========================================
htf2_time = request.security(syminfo.tickerid, i_htf2, time)
htf2_pivot_low = request.security(syminfo.tickerid, i_htf2, ta.pivotlow(low, i_pivot_left, i_pivot_right))
htf2_pivot_high = request.security(syminfo.tickerid, i_htf2, ta.pivothigh(high, i_pivot_left, i_pivot_right))

if i_enable_htf2 and not htf2_counting
    if not na(htf2_pivot_low)
        htf2_counting := true
        htf2_anchor := bar_index
        htf2_count := 0
    else if not na(htf2_pivot_high)
        htf2_counting := true
        htf2_anchor := bar_index
        htf2_count := 0

if i_enable_htf2 and htf2_counting and htf2_time != htf2_last_time
    htf2_last_time := htf2_time
    htf2_count := htf2_count + 1
    
    if f_in_seq(htf2_count, seq)
        y_pos = low - atr_val * 1.5
        
        is_aligned = count == htf2_count and counting
        label_color = is_aligned ? color.yellow : i_htf_color
        
        label.new(bar_index, y_pos, i_htf2 + ":" + str.tostring(htf2_count), 
                 color=color.new(color.white, 100), 
                 textcolor=label_color, 
                 style=label.style_label_up, 
                 size=is_aligned ? size.normal : size.small)
        
        if is_aligned
            label.new(bar_index, high + atr_val * 0.6, "★★ " + str.tostring(htf2_count) + " ★★", 
                     color=color.yellow, 
                     textcolor=color.black, 
                     style=label.style_label_down, 
                     size=size.huge)
        
        if i_show_lines and not na(htf2_last_bar)
            line.new(htf2_last_bar, htf2_last_price, bar_index, low, 
                    color=i_htf_color, 
                    width=1, 
                    style=line.style_dotted)
        
        htf2_last_bar := bar_index
        htf2_last_price := low
    
    if htf2_count >= 31
        htf2_count := 0
        htf2_last_bar := na

// ========================================
// CLEAN STATUS
// ========================================
if barstate.islast
    var table t = table.new(position.top_right, 2, 6, bgcolor=color.new(color.white, 85), border_width=1)
    
    table.cell(t, 0, 0, "TDT", bgcolor=color.new(i_main_color, 70), text_color=color.white)
    table.cell(t, 1, 0, "", bgcolor=color.new(i_main_color, 70))
    
    table.cell(t, 0, 1, "Count", text_size=size.tiny)
    table.cell(t, 1, 1, counting ? str.tostring(count) : "Waiting...", text_color=counting ? color.green : color.gray, text_size=size.tiny)
    
    table.cell(t, 0, 2, "Direction", text_size=size.tiny)
    table.cell(t, 1, 2, counting ? (is_bullish ? "↑ Bull" : "↓ Bear") : "-", text_size=size.tiny)
    
    table.cell(t, 0, 3, i_htf1, text_size=size.tiny)
    table.cell(t, 1, 3, htf1_counting ? str.tostring(htf1_count) : "-", text_color=i_htf_color, text_size=size.tiny)
    
    table.cell(t, 0, 4, i_htf2, text_size=size.tiny)
    table.cell(t, 1, 4, htf2_counting ? str.tostring(htf2_count) : "-", text_color=i_htf_color, text_size=size.tiny)
    
    is_aligned = (count == htf1_count or count == htf2_count) and counting
    table.cell(t, 0, 5, "Aligned", text_size=size.tiny)
    table.cell(t, 1, 5, is_aligned ? "★ YES" : "NO", text_color=is_aligned ? color.yellow : color.gray, text_size=size.tiny)

// ========================================
// ALERTS
// ========================================
if counting and f_in_seq(count, seq)
    alert("TDT: " + str.tostring(count) + " " + (is_bullish ? "Bullish" : "Bearish"), alert.freq_once_per_bar)

if counting and (count == htf1_count or count == htf2_count)
    alert("★ ALIGNMENT at " + str.tostring(count), alert.freq_once_per_bar)
