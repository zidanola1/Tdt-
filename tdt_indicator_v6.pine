//@version=6
indicator("TDT Indicator", shorttitle="TDT", overlay=true, max_labels_count=500, max_lines_count=100, max_boxes_count=100)

// === GROUP: CORE SETTINGS ===
grp_core = "1. Core Settings"
i_mode = input.string("Forward Only", "Counting Mode", options=["Forward Only", "Backward-to-Forward Mirror"], group=grp_core)
i_sequence_str = input.string("7,13,21,31,42", "Sequence 1 (comma-separated)", group=grp_core)
i_sequence_str_2 = input.string("1,5,9,11,17,25,37", "Sequence 2 (comma-separated)", group=grp_core)
i_sequence_str_3 = input.string("1,7,13,21,31,43,57", "Sequence 3 (comma-separated)", group=grp_core)
i_sequence_str_4 = input.string("1,2,3,5,8,13,21", "Sequence 4 (comma-separated)", group=grp_core)
i_sequence_str_5 = input.string("1,4,9,16,25,36,49", "Sequence 5 (comma-separated)", group=grp_core)
i_active_sequence = input.string("Sequence 1", "Active Forward Sequence", options=["Sequence 1", "Sequence 2", "Sequence 3", "Sequence 4", "Sequence 5"], group=grp_core)

// === GROUP: ANCHOR POINT SETTINGS ===
grp_anchor = "2. Anchor Point Settings"
i_anchor_type = input.string("Time", "Anchor Type", options=["Time", "Highest High", "Lowest Low"], group=grp_anchor, tooltip="Time: Anchor at the manual anchor point. Highest High/Lowest Low: Anchor at the first new HH/LL after the manual anchor point.")
i_lookback = input.int(50, "Lookback Period", minval=1, group=grp_anchor, tooltip="Lookback period to determine Highest High or Lowest Low.")
i_manual_anchor_time = input.time(timestamp("2025-08-08T09:00:00"), "Manual Anchor Point", group=grp_anchor, confirm=true, tooltip="Precise manual anchor point for counting start")
i_show_anchor_line = input.bool(true, "Show Anchor Line", group=grp_anchor, tooltip="Display vertical line at anchor point")

// === GROUP: BACKWARD COUNTING ===
grp_back = "3. Backward Counting"
i_enable_backward = input.bool(true, "Enable Backward Counting", group=grp_back)
i_backward_seq_str = input.string("7,13,21,33", "Backward Sequence", group=grp_back)
i_backward_lookback = input.int(100, "Backward Lookback Bars", group=grp_back, tooltip="How many bars to look back for backward counting")

// === GROUP: SHIFT MODE ===
grp_shift = "4. Shift Mode"
i_enable_shift = input.bool(false, "Enable Shift Mode", group=grp_shift)
