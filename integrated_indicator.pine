//@version=5
indicator("Integrated Multi-TF Sweep & CISD", overlay=true, max_lines_count=500, max_labels_count=500, max_bars_back=5000, max_boxes_count=500)

// ===== INPUTS =====
// HTF Options
var g_HTF = "HTF Options"
htf_opt     = input.string("Auto", "HTF Selection method:", options=["Auto","Fixed"], group=g_HTF, inline="htf0")
htf_        = input.timeframe("60", "If Fixed HTF:", group=g_HTF, inline="htf")
showhtf     = input.bool(true, "Show HTF boxes", group=g_HTF, inline="htf1")
width_box   = input.int(1, "Border Width:", group=g_HTF, inline="htf1")
style_box   = input.string(line.style_dotted, "Style:", options=[line.style_solid,line.style_dotted,line.style_dashed], group=g_HTF, inline="htf1")

// Multi-Timeframe Consolidation Options
var g_TF = "Multi-TF Consolidation"
use_tf1         = input.bool(true, "30 Minutes", inline="TF1", group=g_TF)
tf1             = input.timeframe("30", "", inline="TF1", group=g_TF)
tf1_color       = input.color(color.new(#FF1493, 70), "", inline="TF1", group=g_TF)
use_tf1_mid     = input.bool(true, "50% Level", inline="TF1M", group=g_TF)
tf1_mid_color   = input.color(color.new(#FF1493, 50), "", inline="TF1M", group=g_TF)

use_tf2         = input.bool(true, "1 Hour", inline="TF2", group=g_TF)
tf2             = input.timeframe("60", "", inline="TF2", group=g_TF)
tf2_color       = input.color(color.new(#FF4500, 70), "", inline="TF2", group=g_TF)
use_tf2_mid     = input.bool(true, "50% Level", inline="TF2M", group=g_TF)
tf2_mid_color   = input.color(color.new(#FF4500, 50), "", inline="TF2M", group=g_TF)

use_tf3         = input.bool(true, "2 Hours", inline="TF3", group=g_TF)
tf3             = input.timeframe("120", "", inline="TF3", group=g_TF)
tf3_color       = input.color(color.new(#32CD32, 70), "", inline="TF3", group=g_TF)
use_tf3_mid     = input.bool(true, "50% Level", inline="TF3M", group=g_TF)
tf3_mid_color   = input.color(color.new(#32CD32, 50), "", inline="TF3M", group=g_TF)

use_tf4         = input.bool(true, "4 Hours", inline="TF4", group=g_TF)
tf4             = input.timeframe("240", "", inline="TF4", group=g_TF)
tf4_color       = input.color(color.new(#1E90FF, 70), "", inline="TF4", group=g_TF)
use_tf4_mid     = input.bool(true, "50% Level", inline="TF4M", group=g_TF)
tf4_mid_color   = input.color(color.new(#1E90FF, 50), "", inline="TF4M", group=g_TF)

use_tf5         = input.bool(true, "Daily", inline="TF5", group=g_TF)
tf5             = input.timeframe("D", "", inline="TF5", group=g_TF)
tf5_color       = input.color(color.new(#9932CC, 70), "", inline="TF5", group=g_TF)
use_tf5_mid     = input.bool(true, "50% Level", inline="TF5M", group=g_TF)
tf5_mid_color   = input.color(color.new(#9932CC, 50), "", inline="TF5M", group=g_TF)

use_tf6         = input.bool(true, "Weekly", inline="TF6", group=g_TF)
tf6             = input.timeframe("W", "", inline="TF6", group=g_TF)
tf6_color       = input.color(color.new(#FFD700, 70), "", inline="TF6", group=g_TF)
use_tf6_mid     = input.bool(true, "50% Level", inline="TF6M", group=g_TF)
tf6_mid_color   = input.color(color.new(#FFD700, 50), "", inline="TF6M", group=g_TF)

use_tf7         = input.bool(true, "Monthly", inline="TF7", group=g_TF)
tf7             = input.timeframe("M", "", inline="TF7", group=g_TF)
tf7_color       = input.color(color.new(#FF69B4, 70), "", inline="TF7", group=g_TF)
use_tf7_mid     = input.bool(true, "50% Level", inline="TF7M", group=g_TF)
tf7_mid_color   = input.color(color.new(#FF69B4, 50), "", inline="TF7M", group=g_TF)

// Consolidation Range Options
var g_OPT = "Consolidation Options"
minbars         = input.int(1, "Minimum Bars", group=g_OPT)
maxbars         = input.int(250, "Maximum Bars", group=g_OPT)
hllinewidth     = input.int(2, "High/Low Line Width", group=g_OPT)
midlinewidth    = input.int(1, "Mid Line Width", group=g_OPT)

// Colors
var g_COLORS = "Colors"
bull_color = input.color(color.teal, "Bull Color", inline="clr", group=g_COLORS)
bear_color = input.color(color.red, "Bear Color", inline="clr", group=g_COLORS)
range_color = input.color(color.navy, "Range Color", inline="clr", group=g_COLORS)
swept_color = input.color(color.new(#ffeb3b, 32), "Sweep Box Color", inline="clr1", group=g_COLORS)

// Alert Options
var g_ALERT = "Alert Options"
alert_on_m30   = input.bool(false, "Alert on M30 touch", group=g_ALERT)
alert_on_h1    = input.bool(false, "Alert on H1 touch", group=g_ALERT)
alert_on_h2    = input.bool(false, "Alert on H2 touch", group=g_ALERT)
alert_on_h4    = input.bool(false, "Alert on H4 touch", group=g_ALERT)
alert_on_daily = input.bool(false, "Alert on Daily touch", group=g_ALERT)
alert_on_weekly = input.bool(false, "Alert on Weekly touch", group=g_ALERT)
alert_on_monthly = input.bool(false, "Alert on Monthly touch", group=g_ALERT)

// ===== FUNCTIONS =====
// HTF Selection Function
f_look_tf(_tf) =>
    dtf = _tf == "1" ? "15" : _tf == "2" ? "60" : _tf == "3" ? "30" : _tf == "5" ? "60" : _tf == "15" ? "240" : _tf == "30" ? "720" : _tf == "60" ? "1D" : _tf == "240" ? "1W" : _tf == "D" ? "1M" : _tf == "W" ? "3M" : _tf
    dtf

htf = htf_opt == "Auto" ? f_look_tf(timeframe.period) : htf_

// Multi-Timeframe Consolidation Function
process_tf(tf) =>
    var float rangeHigh = na
    var float rangeLow = na
    var float rangeMid = na
    var int rangeStart = 0
    var bool inConsolidation = true
    var bool bullishTouch = false
    var bool bearishTouch = false
    var bool highSwept = false
    var bool lowSwept = false
    
    [tfOpen, tfHigh, tfLow, tfClose, tfTime] = request.security(syminfo.tickerid, tf, [open, high, low, close, time], barmerge.gaps_off, barmerge.lookahead_on)
    
    newBar = ta.change(tfTime) != 0
    
    tfUp = tfHigh
    tfDown = tfLow
    tfChildUp = tfOpen > tfClose ? tfOpen : tfClose
    tfChildDown = tfOpen > tfClose ? tfClose : tfOpen
    
    if newBar
        upControl = tfChildUp > rangeHigh and bar_index - rangeStart > minbars and bar_index - rangeStart <= maxbars
        downControl = tfChildDown < rangeLow and bar_index - rangeStart > minbars and bar_index - rangeStart <= maxbars
        
        if (upControl or downControl)
            inConsolidation := false
        
        if (inConsolidation and tfChildDown <= rangeHigh and tfChildDown >= rangeLow and tfChildUp <= rangeHigh and tfChildUp >= rangeLow and bar_index > 1)
            rangeStart := rangeStart
        else
            rangeHigh := tfHigh
            rangeLow := tfLow
            rangeStart := bar_index
            inConsolidation := true
            highSwept := false
            lowSwept := false
        
        if not inConsolidation and (bar_index - rangeStart > maxbars or bar_index - rangeStart < minbars)
            inConsolidation := true
        
        rangeMid := (rangeHigh + rangeLow) / 2
        bullishTouch := false
        bearishTouch := false
    
    if inConsolidation
        // Check for sweeps on consolidation levels
        if high > rangeHigh and close < rangeHigh
            highSwept := true
        if low < rangeLow and close > rangeLow
            lowSwept := true
        
        // Check for touches
        bullishWickTouch = low < rangeLow and close > rangeLow and high < rangeHigh
        bullishBodyTouch = open < rangeLow and close > rangeLow
        bearishWickTouch = high > rangeHigh and close < rangeHigh and low > rangeLow
        bearishBodyTouch = open > rangeHigh and close < rangeHigh
        
        bullishTouch := bullishWickTouch or bullishBodyTouch
        bearishTouch := bearishWickTouch or bearishBodyTouch
    
    [rangeHigh, rangeLow, rangeMid, rangeStart, inConsolidation, newBar, bullishTouch, bearishTouch, highSwept, lowSwept]

// Plot Lines Function
plot_lines(tfColor, midColor, high, low, mid, start, inRange, newBar, useMid, bullishTouch, bearishTouch, tfName) =>
    var line highLine = na
    var line lowLine = na
    var line midLine = na
    
    if newBar and inRange
        if not na(highLine)
            line.delete(highLine)
            line.delete(lowLine)
            line.delete(midLine)
        
        validStart = math.max(start, 0)
        highLine := line.new(validStart, high, bar_index, high, color=tfColor, width=hllinewidth)
        lowLine := line.new(validStart, low, bar_index, low, color=tfColor, width=hllinewidth)
        if useMid
            midLine := line.new(validStart, mid, bar_index, mid, color=midColor, width=midlinewidth, style=line.style_dashed)
    
    if not na(highLine) and inRange
        line.set_x2(highLine, bar_index)
        line.set_x2(lowLine, bar_index)
        if useMid and not na(midLine)
            line.set_x2(midLine, bar_index)
    
    [bullishTouch, bearishTouch]

// Helper function to add to array
add_to_array(arr, value) =>
    array.unshift(arr, value)
    if array.size(arr) > 100
        array.pop(arr)
    arr

// Text formatting function
f_text(string _tf) =>
    _text = str.tonumber(_tf) < 59 ? _tf + 'm' : str.tonumber(_tf) > 59 ? 'h' + str.tostring(math.floor(str.tonumber(_tf)/60)) : _tf
    _text := _tf == "1D" ? "D" : _tf == "1W" ? "W" : _tf == "1M" ? "M" : _text

// ===== VARIABLES =====
var o0 = open
var h0 = high
var l0 = low
var h0bar = bar_index
var l0bar = bar_index
var h1bar = bar_index
var l1bar = bar_index
var h0t = time
var l0t = time
var t0 = time
var c0 = close
var h1 = high
var l1 = low
var t1 = time
var c1 = close
var o1 = open

// ===== MAIN LOGIC =====
// Update HTF variables
if timeframe.change(htf)
    t0 := time
    o0 := open
    h0 := high
    l0 := low

if high >= h0
    h0 := high
    h0bar := bar_index
    h0t := time    

if low <= l0
    l0 := low
    l0bar := bar_index
    l0t := time

c0 := close

if timeframe.change(htf)
    o1 := o0[1]
    h1 := h0[1]
    l1 := l0[1]
    t1 := t0[1]
    c1 := close[1]
    h1bar := h0bar[1]
    l1bar := l0bar[1]

// Process multi-timeframe consolidation with sweep detection
[high1, low1, mid1, start1, inRange1, newBar1, bullishTouch1, bearishTouch1, highSwept1, lowSwept1] = process_tf(tf1)
[high2, low2, mid2, start2, inRange2, newBar2, bullishTouch2, bearishTouch2, highSwept2, lowSwept2] = process_tf(tf2)
[high3, low3, mid3, start3, inRange3, newBar3, bullishTouch3, bearishTouch3, highSwept3, lowSwept3] = process_tf(tf3)
[high4, low4, mid4, start4, inRange4, newBar4, bullishTouch4, bearishTouch4, highSwept4, lowSwept4] = process_tf(tf4)
[high5, low5, mid5, start5, inRange5, newBar5, bullishTouch5, bearishTouch5, highSwept5, lowSwept5] = process_tf(tf5)
[high6, low6, mid6, start6, inRange6, newBar6, bullishTouch6, bearishTouch6, highSwept6, lowSwept6] = process_tf(tf6)
[high7, low7, mid7, start7, inRange7, newBar7, bullishTouch7, bearishTouch7, highSwept7, lowSwept7] = process_tf(tf7)

// Plot consolidation lines
if use_tf1
    [bullishTouch1, bearishTouch1] = plot_lines(tf1_color, tf1_mid_color, high1, low1, mid1, start1, inRange1, newBar1, use_tf1_mid, bullishTouch1, bearishTouch1, "M30")
if use_tf2
    [bullishTouch2, bearishTouch2] = plot_lines(tf2_color, tf2_mid_color, high2, low2, mid2, start2, inRange2, newBar2, use_tf2_mid, bullishTouch2, bearishTouch2, "H1")
if use_tf3
    [bullishTouch3, bearishTouch3] = plot_lines(tf3_color, tf3_mid_color, high3, low3, mid3, start3, inRange3, newBar3, use_tf3_mid, bullishTouch3, bearishTouch3, "H2")
if use_tf4
    [bullishTouch4, bearishTouch4] = plot_lines(tf4_color, tf4_mid_color, high4, low4, mid4, start4, inRange4, newBar4, use_tf4_mid, bullishTouch4, bearishTouch4, "H4")
if use_tf5
    [bullishTouch5, bearishTouch5] = plot_lines(tf5_color, tf5_mid_color, high5, low5, mid5, start5, inRange5, newBar5, use_tf5_mid, bullishTouch5, bearishTouch5, "D")
if use_tf6
    [bullishTouch6, bearishTouch6] = plot_lines(tf6_color, tf6_mid_color, high6, low6, mid6, start6, inRange6, newBar6, use_tf6_mid, bullishTouch6, bearishTouch6, "W")
if use_tf7
    [bullishTouch7, bearishTouch7] = plot_lines(tf7_color, tf7_mid_color, high7, low7, mid7, start7, inRange7, newBar7, use_tf7_mid, bullishTouch7, bearishTouch7, "M")

// ===== INTEGRATED SWEEP DETECTION =====
// Global sweep variables
h_swept = false
l_swept = false

// Check consolidation level sweeps (highest priority)
if highSwept1 or highSwept2 or highSwept3 or highSwept4 or highSwept5 or highSwept6 or highSwept7
    h_swept := true
if lowSwept1 or lowSwept2 or lowSwept3 or lowSwept4 or lowSwept5 or lowSwept6 or lowSwept7
    l_swept := true

// Also check HTF sweeps as backup
if h0 > h1 and math.max(o0, c0) < h1
    h_swept := true
if l0 < l1 and math.min(o0, c0) > l1
    l_swept := true

// Plot HTF boxes
if showhtf
    if time == t0 and timeframe.period != htf
        htf_box_color = c1 > o1 ? bull_color : c1 < o1 ? bear_color : range_color 
        boxhtf1 = box.new(left=t1, top=h1, right=t0, bottom=l1, xloc=xloc.bar_time, border_width=width_box, border_style=style_box, bgcolor=color.rgb(255, 255, 255, 100), border_color=htf_box_color)
    
    if timeframe.period != htf
        htf_box_color = c0 > o0 ? bull_color : c0 < o0 ? bear_color : range_color         
        boxhtf = box.new(left=t0, top=high > h0 ? high : h0, right=time+1, bottom=low < l0 ? low : l0, xloc=xloc.bar_time, border_width=width_box, border_style=style_box, bgcolor=color.rgb(255, 255, 255, 100), border_color=htf_box_color)
        box.delete(boxhtf[1])

// Plot sweep boxes on consolidation levels
if highSwept1 and inRange1
    sweep_box_high1 = box.new(left=bar_index-5, top=high1, right=bar_index, bottom=high1-0.001, xloc=xloc.bar_index, border_width=2, border_style=line.style_dotted, bgcolor=swept_color, border_color=bear_color)
    box.delete(sweep_box_high1[1])

if lowSwept1 and inRange1
    sweep_box_low1 = box.new(left=bar_index-5, top=low1+0.001, right=bar_index, bottom=low1, xloc=xloc.bar_index, border_width=2, border_style=line.style_dotted, bgcolor=swept_color, border_color=bull_color)
    box.delete(sweep_box_low1[1])

// ===== CISD ANALYSIS WITH INTEGRATED TIMEFRAMES =====
// CISD Timeframe Pairs (as requested)
var g_CISD = "CISD Timeframe Pairs"
use_cisd_30_3 = input.bool(true, "30min - 3min CISD", group=g_CISD)
use_cisd_1h_5 = input.bool(true, "1h - 5min CISD", group=g_CISD)
use_cisd_4h_15 = input.bool(true, "4h - 15min CISD", group=g_CISD)
use_cisd_day_1h = input.bool(true, "Day - 1h CISD", group=g_CISD)
use_cisd_week_4h = input.bool(true, "Week - 4h CISD", group=g_CISD)
use_cisd_month_day = input.bool(true, "Month - Day CISD", group=g_CISD)

// Volume Confirmation Settings
var g_VOLUME = "Smart Money Detection"
use_volume_confirmation = input.bool(true, "Volume Confirmation", group=g_VOLUME)
volume_multiplier = input.float(1.5, "Volume Spike Multiplier", minval=1.0, maxval=5.0, step=0.1, group=g_VOLUME)
volume_period = input.int(20, "Volume SMA Period", minval=10, maxval=100, group=g_VOLUME)

// Smart Money Trap Detection
use_smart_money_traps = input.bool(true, "Smart Money Traps", group=g_VOLUME)
trap_confirmation = input.bool(true, "Trap Confirmation", group=g_VOLUME)

var bull_level = high
var bear_level = low
var bull_index = bar_index
var bear_index = bar_index
var bucisdg = array.new_line()
var becisdg = array.new_line()
var bull_alarm = false
var bear_alarm = false
var bull_cisd_ara = false
var bear_cisd_ara = false
var saybear = 0
var saybull = 0
var xcisd = false
var ycisd = false
var mm = bar_index
var nn = bar_index

// Volume Confirmation Logic
volume_sma = ta.sma(volume, volume_period)
volume_spike = volume > volume_sma * volume_multiplier
volume_confirmed = use_volume_confirmation ? volume_spike : true

// Smart Money Trap Detection
bull_trap = use_smart_money_traps ? (high > high[1] and close < low[1]) : false
bear_trap = use_smart_money_traps ? (low < low[1] and close > high[1]) : false

// Enhanced CISD detection logic - now with volume confirmation and smart money traps
if l_swept and volume_confirmed
    bull_cisd_ara := true
if h_swept and volume_confirmed
    bear_cisd_ara := true

// Smart Money Trap Enhanced CISD
if bull_trap and volume_confirmed
    bear_cisd_ara := true  // Bull trap = bearish signal
if bear_trap and volume_confirmed
    bull_cisd_ara := true  // Bear trap = bullish signal

// Specific CISD timeframe logic
// 30min - 3min CISD
if use_cisd_30_3 and timeframe.period == "3" and (highSwept1 or lowSwept1)
    if highSwept1 and close >= low[1] and close <= high[1] and volume_confirmed
        bear_cisd_ara := true
    if lowSwept1 and close >= low[1] and close <= high[1] and volume_confirmed
        bull_cisd_ara := true

// 1h - 5min CISD
if use_cisd_1h_5 and timeframe.period == "5" and (highSwept2 or lowSwept2)
    if highSwept2 and close >= low[1] and close <= high[1] and volume_confirmed
        bear_cisd_ara := true
    if lowSwept2 and close >= low[1] and close <= high[1] and volume_confirmed
        bull_cisd_ara := true

// 4h - 15min CISD
if use_cisd_4h_15 and timeframe.period == "15" and (highSwept4 or lowSwept4)
    if highSwept4 and close >= low[1] and close <= high[1] and volume_confirmed
        bear_cisd_ara := true
    if lowSwept4 and close >= low[1] and close <= high[1] and volume_confirmed
        bull_cisd_ara := true

// Day - 1h CISD
if use_cisd_day_1h and timeframe.period == "60" and (highSwept5 or lowSwept5)
    if highSwept5 and close >= low[1] and close <= high[1] and volume_confirmed
        bear_cisd_ara := true
    if lowSwept5 and close >= low[1] and close <= high[1] and volume_confirmed
        bull_cisd_ara := true

// Week - 4h CISD
if use_cisd_week_4h and timeframe.period == "240" and (highSwept6 or lowSwept6)
    if highSwept6 and close >= low[1] and close <= high[1] and volume_confirmed
        bear_cisd_ara := true
    if lowSwept6 and close >= low[1] and close <= high[1] and volume_confirmed
        bull_cisd_ara := true

// Month - Day CISD
if use_cisd_month_day and timeframe.period == "D" and (highSwept7 or lowSwept7)
    if highSwept7 and close >= low[1] and close <= high[1] and volume_confirmed
        bear_cisd_ara := true
    if lowSwept7 and close >= low[1] and close <= high[1] and volume_confirmed
        bull_cisd_ara := true

up = close > open
dw = close < open
eq = close == open

// Bullish CISD
if low == l0 and low < l1
    if (dw[0] or eq[0]) and (up[1] or eq[1]) and not (eq[0] and eq[1])
        bull_level := open
        bull_index := bar_index
        add_to_array(bucisdg, line.new(x1=bull_index, y1=bull_level, x2=bull_index+4, y2=bull_level, color=bull_color, width=2, style=line.style_dotted))
    else if up and up[1]
        bull_level := high
        bull_index := bar_index
    else
        for i = 2 to 10
            if low[i] < low
                break
            if (up[i] or eq[i]) and dw[i-1]
                bar = i - 1
                bull_level := open[bar]
                bull_index := bar_index - bar
                bull_index := i > 1 and open[i-2] > bull_level ? bar_index - (i-2) : bull_index
                bull_level := i > 1 and open[i-2] > bull_level ? open[i-2] : bull_level
                if bull_level < open and not (close > open)
                    bull_level := open
                    bull_index := bar_index
                if bull_level < open and (close > open)
                    bull_level := high
                    bull_index := bar_index
                add_to_array(bucisdg, line.new(x1=bull_index, y1=bull_level, x2=bull_index+4, y2=bull_level, color=bull_color, width=2, style=line.style_dotted))
                break

// Bearish CISD
if high == h0 and high > h1
    if (up[0] or eq[0]) and (dw[1] or eq[1]) and not (eq[0] and eq[1])
        bear_level := open
        bear_index := bar_index
        add_to_array(becisdg, line.new(x1=bear_index, y1=bear_level, x2=bear_index+4, y2=bear_level, color=bear_color, width=2, style=line.style_dotted))
    else if dw and dw[1]
        bear_level := low
        bear_index := bar_index
        add_to_array(becisdg, line.new(x1=bear_index, y1=bear_level, x2=bear_index+4, y2=bear_level, color=bear_color, width=2, style=line.style_dotted))
    else
        for i = 2 to 10
            if high[i] > high
                break
            if (dw[i] or eq[i]) and up[i-1]
                ybar = i - 1
                bear_level := open[ybar]
                bear_index := bar_index - ybar
                bear_index := i > 1 and open[i-2] < bear_level ? bar_index - (i-2) : bear_index
                bear_level := i > 1 and open[i-2] < bear_level ? open[i-2] : bear_level
                if bear_level > open and not (close < open)
                    bear_level := open
                    bear_index := bar_index
                if bear_level > open and (close < open)
                    bear_level := low
                    bear_index := bar_index
                add_to_array(becisdg, line.new(x1=bear_index, y1=bear_level, x2=bear_index+4, y2=bear_level, color=bear_color, width=2, style=line.style_dotted))
                break

// Reset CISD conditions
if high >= h0[1]
    saybear := 0
    bear_cisd_ara := true
    ycisd := false
if low <= l0[1]
    saybull := 0
    bull_cisd_ara := true
    xcisd := false

// CISD intersection detection - now using integrated sweep logic
m = l0 < l1 ? bar_index - l0bar : bar_index - l1bar
bullcisd = (close[1] > bull_level[1] and close[2] <= bull_level[1] and bar_index - bull_index[1] > 1 and l0 < l1 and m < 30) or (close[1] > bull_level[1] and close[2] <= bull_level[1] and bar_index - bull_index[1] > 1 and l1 < l0 and m < 30 and l_swept[1])

if bullcisd and xcisd[1] == false
    xcisd := true
    mm := bar_index

xbull = xcisd and saybull == 0 and bull_cisd_ara and ((l_swept[1]) or (l_swept[1] and l1 < l0))

if xbull
    bucisd = box.new(left=bull_index[1], top=bull_level[1], right=mm-1, bottom=bull_level[1], border_color=bull_color, border_width=1, text="cisd+", text_color=bull_color, text_size=size.tiny, text_halign=text.align_center, text_valign=text.align_bottom)
    bull_alarm := true
    if bull_alarm and saybull == 0
        alert(syminfo.tickerid + ',' + timeframe.period + ',🟢 Long Alarm', alert.freq_once_per_bar)
        saybull := 1
    bull_level := 1000000.0
    bull_cisd_ara := false
    xcisd := false
    if array.size(bucisdg) > 0
        dbox = array.get(bucisdg, 0)
        line.delete(dbox)
        array.remove(bucisdg, 0)

if array.size(bucisdg) > 1
    for i = array.size(bucisdg) - 1 to 1
        dbox = array.get(bucisdg, i)
        line.delete(dbox)
        array.remove(bucisdg, i)

// Bearish CISD intersection
n = h0 > h1 ? bar_index - h0bar : bar_index - h1bar
bearcisd = (close[1] < bear_level[1] and close[2] >= bear_level[1] and bar_index - bear_index[1] > 1 and h0 > h1 and n < 30) or (close[1] < bear_level[1] and close[2] >= bear_level[1] and bar_index - bear_index[1] > 1 and h1 > h0 and n < 30 and h_swept[1])

if bearcisd and ycisd[1] == false
    ycisd := true
    nn := bar_index

xbear = ycisd and ((h_swept[1]) or (h_swept[1] and h1 > h0)) and saybear == 0 and bear_cisd_ara

if xbear
    becisd = box.new(left=bear_index[1], top=bear_level[1], right=nn-1, bottom=bear_level[1], border_color=bear_color, border_width=1, text="cisd-", text_color=bear_color, text_size=size.tiny, text_halign=text.align_center, text_valign=text.align_top)
    bear_alarm := true
    if bear_alarm and saybear == 0
        alert(syminfo.tickerid + ',' + timeframe.period + ',🔴 Short Alarm', alert.freq_once_per_bar)
        saybear := 1
    bear_level := 0.0
    bear_cisd_ara := false
    ycisd := false
    if array.size(becisdg) > 0
        dbox = array.get(becisdg, 0)
        line.delete(dbox)
        array.remove(becisdg, 0)

if array.size(becisdg) > 1
    for i = array.size(becisdg) - 1 to 1
        dbox = array.get(becisdg, i)
        line.delete(dbox)
        array.remove(becisdg, i)

// Plot CISD signals
plotshape(bull_alarm, title="Bullish CISD", style=shape.arrowup, location=location.belowbar, color=bull_color, size=size.tiny, text="", textcolor=color.green, offset=-1)
plotshape(bear_alarm, title="Bearish CISD", style=shape.arrowdown, location=location.abovebar, color=bear_color, size=size.tiny, text="", textcolor=color.red, offset=-1)

// Plot Volume Confirmation and Smart Money Traps
plotshape(volume_spike and use_volume_confirmation, title="Volume Spike", style=shape.circle, location=location.bottom, color=color.yellow, size=size.tiny, text="V", textcolor=color.black, offset=0)
plotshape(bull_trap and use_smart_money_traps, title="Bull Trap", style=shape.triangledown, location=location.abovebar, color=color.red, size=size.small, text="TRAP", textcolor=color.white, offset=0)
plotshape(bear_trap and use_smart_money_traps, title="Bear Trap", style=shape.triangleup, location=location.belowbar, color=color.green, size=size.small, text="TRAP", textcolor=color.white, offset=0)

// Reset alarms
bull_alarm := false
bear_alarm := false

// ===== ALERTS =====
if alert_on_m30 and (bullishTouch1 or bearishTouch1)
    alert("M30 touch detected", alert.freq_once_per_bar_close)
if alert_on_h1 and (bullishTouch2 or bearishTouch2)
    alert("H1 touch detected", alert.freq_once_per_bar_close)
if alert_on_h2 and (bullishTouch3 or bearishTouch3)
    alert("H2 touch detected", alert.freq_once_per_bar_close)
if alert_on_h4 and (bullishTouch4 or bearishTouch4)
    alert("H4 touch detected", alert.freq_once_per_bar_close)
if alert_on_daily and (bullishTouch5 or bearishTouch5)
    alert("Daily touch detected", alert.freq_once_per_bar_close)
if alert_on_weekly and (bullishTouch6 or bearishTouch6)
    alert("Weekly touch detected", alert.freq_once_per_bar_close)
if alert_on_monthly and (bullishTouch7 or bearishTouch7)
    alert("Monthly touch detected", alert.freq_once_per_bar_close)

// Enhanced Alerts for Volume Confirmation and Smart Money Traps
if volume_spike and use_volume_confirmation
    alert("🔥 VOLUME SPIKE DETECTED! Potential institutional move!", alert.freq_once_per_bar_close)
if bull_trap and use_smart_money_traps and volume_confirmed
    alert("🚨 BULL TRAP DETECTED! Smart money selling into strength!", alert.freq_once_per_bar_close)
if bear_trap and use_smart_money_traps and volume_confirmed
    alert("🚨 BEAR TRAP DETECTED! Smart money buying weakness!", alert.freq_once_per_bar_close)

// Risk-Reward Calculator for CISD Signals - Only on NEW signals
var bool last_bull_signal = false
var bool last_bear_signal = false

if bull_cisd_ara and volume_confirmed and not last_bull_signal
    bull_target_1 = close + (high - low) * 1.5  // 1.5:1 RR
    bull_target_2 = close + (high - low) * 2.0  // 2:1 RR
    bull_stop = low - (high - low) * 0.5        // 0.5:1 risk
    label.new(bar_index, high, text="🎯 BULL TARGETS:\n1.5R: " + str.tostring(bull_target_1, "#.##") + "\n2.0R: " + str.tostring(bull_target_2, "#.##") + "\nSTOP: " + str.tostring(bull_stop, "#.##"), style=label.style_label_down, color=color.green, textcolor=color.white, size=size.small)
    last_bull_signal := true

if bear_cisd_ara and volume_confirmed and not last_bear_signal
    bear_target_1 = close - (high - low) * 1.5  // 1.5:1 RR
    bear_target_2 = close - (high - low) * 2.0  // 2:1 RR
    bear_stop = high + (high - low) * 0.5       // 0.5:1 risk
    label.new(bar_index, low, text="🎯 BEAR TARGETS:\n1.5R: " + str.tostring(bear_target_1, "#.##") + "\n2.0R: " + str.tostring(bear_target_2, "#.##") + "\nSTOP: " + str.tostring(bear_stop, "#.##"), style=label.style_label_up, color=color.red, textcolor=color.white, size=size.small)
    last_bear_signal := true

// Reset signals when conditions change
if not bull_cisd_ara
    last_bull_signal := false
if not bear_cisd_ara
    last_bear_signal := false